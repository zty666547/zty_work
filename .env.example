# ============================================================
#  环境变量模板 —— 把它复制为 .env 并填入真实值
#  cp .env.example .env
# ============================================================

# ---- 运行模式 ----
# dev: 开发调试模式（日志更详细）; prod: 生产模式
APP_ENV=dev

# ---- DeepSeek 大模型（用于实体/关系抽取 + 问答生成）----
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Neo4j 图数据库 ----
# 本地（直接安装 Neo4j 或用 docker compose）：
#   数据库名默认 neo4j，用户名默认 neo4j，初始密码在首次启动时/容器中设为 12345678
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# ---- 数据 / 抽取配置 ----
# 图谱构建方式：
#   structured -> 直接从 data/raw/movies_structured.json 构建（无需 LLM，演示最稳）
#   llm        -> 让 DeepSeek 从 data/raw/movie_docs.txt 抽取实体/关系（展示 LLM 信息抽取能力）
EXTRACTION_MODE=structured

# 知识图谱 Schema（逗号分隔的实体/关系类型，用于约束 LLM 抽取）
# ENTITY_TYPES=Person,Movie,Genre
# RELATION_TYPES=DIRECTED,ACTED_IN,HAS_GENRE
