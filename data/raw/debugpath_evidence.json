  "description": "DebugPath文本证据层：30条基于官方文档与公开问题改写的可检索证据片段。",
  "source": {"title": "DebugPath Evidence Layer", "version": "2026-09-06.1"},
  "entities": {
    "DocumentSource": [
      {"name": "Python导入系统文档", "props": {"url": "https://docs.python.org/3/reference/import.html", "publisher": "Python Software Foundation"}},
      {"name": "pip解释器管理文档", "props": {"url": "https://pip.pypa.io/en/stable/topics/python-option/", "publisher": "Python Packaging Authority"}},
      {"name": "Neo4j高级连接文档", "props": {"url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "publisher": "Neo4j"}},
      {"name": "PyTorch问题77520", "props": {"url": "https://github.com/pytorch/pytorch/issues/77520", "publisher": "PyTorch GitHub"}},
      {"name": "PyTorch问题81549", "props": {"url": "https://github.com/pytorch/pytorch/issues/81549", "publisher": "PyTorch GitHub"}},
      {"name": "PyTorch问题144835", "props": {"url": "https://github.com/pytorch/pytorch/issues/144835", "publisher": "PyTorch GitHub"}}
    ],
    "EvidenceChunk": [
      {"name": "E001-模块未找到异常", "props": {"chunk_id": "E001", "text": "当import无法定位目标模块时会引发ModuleNotFoundError，它是ImportError的子类。先确认当前解释器环境中是否安装目标包。", "keywords": ["ModuleNotFoundError", "No module named", "包未安装"], "source_title": "Python内置异常文档", "url": "https://docs.python.org/3/library/exceptions.html", "section": "ModuleNotFoundError", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E002-python调用pip", "props": {"chunk_id": "E002", "text": "python -m pip会让pip使用所指定的Python解释器，适合核对安装环境与运行环境是否一致。", "keywords": ["python -m pip", "虚拟环境", "解释器路径"], "source_title": "pip用户指南", "url": "https://pip.pypa.io/en/stable/user_guide/", "section": "Running pip", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E003-pip指定解释器", "props": {"chunk_id": "E003", "text": "pip的--python选项可以明确指定要管理的Python或虚拟环境，避免包被安装到另一个解释器。", "keywords": ["pip --python", "wrong environment", "解释器不一致"], "source_title": "pip解释器管理文档", "url": "https://pip.pypa.io/en/stable/topics/python-option/", "section": "Managing a different Python interpreter", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E004-导入路径搜索", "props": {"chunk_id": "E004", "text": "Python按sys.path中的位置搜索模块；当前目录中的同名py文件可能先于第三方包被找到。", "keywords": ["sys.path", "同名文件", "module shadowing", "ImportError"], "source_title": "Python导入系统文档", "url": "https://docs.python.org/3/reference/import.html", "section": "The path based finder", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E005-检查模块来源", "props": {"chunk_id": "E005", "text": "导入系统从搜索路径定位模块。检查模块的__file__位置可以发现项目目录中的同名模块遮蔽。", "keywords": ["__file__", "同名模块", "导入异常"], "source_title": "Python导入系统文档", "url": "https://docs.python.org/3/reference/import.html", "section": "Searching", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E006-依赖版本约束", "props": {"chunk_id": "E006", "text": "pip解析依赖时必须同时满足包和Python版本约束；无兼容候选版本时应调整Python或依赖版本。", "keywords": ["requires python", "版本不兼容", "dependency conflict", "wheel"], "source_title": "pip依赖解析文档", "url": "https://pip.pypa.io/en/stable/topics/dependency-resolution/", "section": "Dependency resolution", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E007-版本冲突检查", "props": {"chunk_id": "E007", "text": "安装成功不代表所有依赖兼容，可记录Python版本并使用pip check定位不满足的依赖要求。", "keywords": ["pip check", "Python version", "依赖冲突", "ImportError"], "source_title": "pip依赖解析文档", "url": "https://pip.pypa.io/en/stable/topics/dependency-resolution/", "section": "Dealing with dependency conflicts", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E008-当前环境查询包", "props": {"chunk_id": "E008", "text": "应使用运行程序的Python执行python -m pip show包名；普通pip show的结果可能来自另一个环境。", "keywords": ["pip show", "already installed", "No module named", "IDE"], "source_title": "pip用户指南", "url": "https://pip.pypa.io/en/stable/user_guide/", "section": "Running pip", "platforms": ["macos", "windows", "linux"]}},

      {"name": "E009-PyTorch安装构建", "props": {"chunk_id": "E009", "text": "PyTorch安装页面要求按操作系统和计算平台选择构建；只安装CPU构建时torch.version.cuda会是None。", "keywords": ["torch.version.cuda None", "CPU build", "CUDA不可用"], "source_title": "PyTorch本地安装指南", "url": "https://pytorch.org/get-started/locally/", "section": "Start Locally", "platforms": ["windows", "linux"]}},
      {"name": "E010-选择CUDA构建", "props": {"chunk_id": "E010", "text": "有可用NVIDIA GPU时应从官方安装选择器选择匹配的CUDA计算平台版本，而不是CPU选项。", "keywords": ["NVIDIA GPU", "CUDA build", "安装CPU版PyTorch"], "source_title": "PyTorch本地安装指南", "url": "https://pytorch.org/get-started/locally/", "section": "Compute Platform", "platforms": ["windows", "linux"]}},
      {"name": "E011-CUDA可用性检查", "props": {"chunk_id": "E011", "text": "torch.cuda.is_available返回当前环境是否可以使用CUDA，可作为驱动、构建和设备排查的入口检查。", "keywords": ["torch.cuda.is_available false", "CUDA available", "检测不到GPU"], "source_title": "PyTorch CUDA可用性文档", "url": "https://docs.pytorch.org/docs/stable/generated/torch.cuda.is_available.html", "section": "torch.cuda.is_available", "platforms": ["windows", "linux"]}},
      {"name": "E012-驱动检查", "props": {"chunk_id": "E012", "text": "系统无法通过nvidia-smi识别显卡和驱动时，应先恢复NVIDIA驱动，再判断PyTorch构建。", "keywords": ["nvidia-smi failed", "NVIDIA driver", "CUDA不可用"], "source_title": "PyTorch CUDA可用性文档", "url": "https://docs.pytorch.org/docs/stable/generated/torch.cuda.is_available.html", "section": "CUDA availability", "platforms": ["windows", "linux"]}},
      {"name": "E013-混合安装环境", "props": {"chunk_id": "E013", "text": "公开问题中同时出现conda和pip安装的不同torch版本；混合构建可能导致运行时加载的PyTorch与预期CUDA配置不同。", "keywords": ["conda pip torch", "CUDA 11.3", "build mismatch"], "source_title": "PyTorch问题77520", "url": "https://github.com/pytorch/pytorch/issues/77520", "section": "Environment report", "platforms": ["linux"]}},
      {"name": "E014-CUDA初始化错误802", "props": {"chunk_id": "E014", "text": "公开问题记录了CUDA initialization error 802，即使更换多个CUDA环境仍不可用，应核对驱动、PyTorch构建和运行时组合。", "keywords": ["error 802", "system not yet initialized", "CUDA initialization"], "source_title": "PyTorch问题81549", "url": "https://github.com/pytorch/pytorch/issues/81549", "section": "Issue description", "platforms": ["linux"]}},
      {"name": "E015-容器GPU映射", "props": {"chunk_id": "E015", "text": "宿主机GPU正常而容器内CUDA不可用时，需要确认容器是否获得GPU设备和相应运行时权限。", "keywords": ["Docker", "container GPU", "宿主机", "CUDA unavailable"], "source_title": "PyTorch问题144835", "url": "https://github.com/pytorch/pytorch/issues/144835", "section": "Container environment", "platforms": ["linux"]}},
      {"name": "E016-容器可见设备变量", "props": {"chunk_id": "E016", "text": "CUDA_VISIBLE_DEVICES等运行环境设置可能让容器中的可见设备数量变为零，应先检查映射和变量再重装软件。", "keywords": ["CUDA_VISIBLE_DEVICES", "container", "device count zero"], "source_title": "PyTorch问题144835", "url": "https://github.com/pytorch/pytorch/issues/144835", "section": "CUDA unknown error", "platforms": ["linux"]}},
      {"name": "E017-macOS使用MPS", "props": {"chunk_id": "E017", "text": "PyTorch在macOS上提供MPS后端以使用Apple GPU；macOS环境不应把CUDA作为默认加速路径。", "keywords": ["macOS", "Apple Silicon", "MPS", "CUDA不可用"], "source_title": "PyTorch MPS后端说明", "url": "https://docs.pytorch.org/docs/stable/notes/mps.html", "section": "MPS backend", "platforms": ["macos"]}},
      {"name": "E018-MPS可用性", "props": {"chunk_id": "E018", "text": "在Mac上可检查torch.backends.mps.is_available；若MPS不可用则使用CPU或检查系统和PyTorch版本要求。", "keywords": ["torch.backends.mps.is_available", "Intel Mac", "Apple GPU"], "source_title": "PyTorch MPS后端说明", "url": "https://docs.pytorch.org/docs/stable/notes/mps.html", "section": "Check availability", "platforms": ["macos"]}},
      {"name": "E019-驱动先于工具包", "props": {"chunk_id": "E019", "text": "torch包含CUDA构建但系统驱动不可用时，单纯重装CUDA工具包不能代替恢复可工作的NVIDIA驱动。", "keywords": ["driver unavailable", "nvidia-smi", "torch CUDA build"], "source_title": "PyTorch本地安装指南", "url": "https://pytorch.org/get-started/locally/", "section": "Prerequisites", "platforms": ["windows", "linux"]}},

      {"name": "E020-进程环境变量", "props": {"chunk_id": "E020", "text": "os.environ表示当前进程可见的环境变量；终端中设置过变量不等于当前应用进程一定能够读取。", "keywords": ["environment variable missing", "API key", "os.environ"], "source_title": "Python环境变量文档", "url": "https://docs.python.org/3/library/os.html#os.environ", "section": "os.environ", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E021-Neo4j环境配置", "props": {"chunk_id": "E021", "text": "Neo4j连接示例可从环境变量读取URI、用户名和密码；变量缺失时应在创建驱动前明确报错。", "keywords": ["NEO4J_URI", "NEO4J_PASSWORD", "环境变量为空"], "source_title": "Neo4j Python连接手册", "url": "https://neo4j.com/docs/python-manual/current/connect/", "section": "Connect to an Aura instance", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E022-Neo4j连接URI", "props": {"chunk_id": "E022", "text": "Neo4j驱动URI由scheme、host和可选port组成；协议、主机或端口错误会导致连接验证失败。", "keywords": ["neo4j URI", "bolt", "wrong host", "服务地址配置错误"], "source_title": "Neo4j高级连接文档", "url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "section": "Connection URI", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E023-URI不支持嵌套路径", "props": {"chunk_id": "E023", "text": "Neo4j驱动不支持把数据库配置成域名后的嵌套HTTP路径，服务必须能从URI对应主机和Bolt端口访问。", "keywords": ["URI path", "hostname", "connection failed"], "source_title": "Neo4j高级连接文档", "url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "section": "Connection URI", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E024-立即验证连接", "props": {"chunk_id": "E024", "text": "创建Neo4j Driver不会立即建立连接；应调用verify_connectivity检查服务是否运行、地址是否可达及认证是否有效。", "keywords": ["verify_connectivity", "Connection refused", "服务未启动"], "source_title": "Neo4j Python连接手册", "url": "https://neo4j.com/docs/python-manual/current/connect/", "section": "Connect to the database", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E025-连接被拒绝", "props": {"chunk_id": "E025", "text": "当目标主机端口没有服务监听时，连接验证可能出现Connection refused，应先确认目标进程和监听地址。", "keywords": ["Connection refused", "localhost 7687", "service stopped"], "source_title": "Neo4j Python连接手册", "url": "https://neo4j.com/docs/python-manual/current/connect/", "section": "Connection errors", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E026-Neo4j认证", "props": {"chunk_id": "E026", "text": "Neo4j基本认证需要正确的用户名和密码；服务可达但认证失败时应更新认证配置，而不是修改端口。", "keywords": ["authentication failed", "Unauthorized", "用户名密码"], "source_title": "Neo4j高级连接文档", "url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "section": "Authentication methods", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E027-令牌认证失败", "props": {"chunk_id": "E027", "text": "401 Unauthorized通常表示请求已到达服务但令牌或认证信息未通过校验，应检查密钥是否有效及是否属于当前服务。", "keywords": ["401 Unauthorized", "invalid token", "API认证失败"], "source_title": "Neo4j高级连接文档", "url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "section": "Authentication", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E028-Bolt端口", "props": {"chunk_id": "E028", "text": "连接URI中的可选端口表示Bolt服务端口；应确认预期端口由目标服务监听而不是其他进程占用。", "keywords": ["port 7687", "Address already in use", "端口被占用"], "source_title": "Neo4j高级连接文档", "url": "https://neo4j.com/docs/python-manual/current/connect-advanced/", "section": "Connection URI", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E029-区分地址与服务状态", "props": {"chunk_id": "E029", "text": "健康检查失败但未出现明确Connection refused时，应先核对scheme、host和port；明确拒绝连接则优先检查服务是否启动。", "keywords": ["health check failed", "wrong URI", "Connection refused"], "source_title": "Neo4j Python连接手册", "url": "https://neo4j.com/docs/python-manual/current/connect/", "section": "Verify connectivity", "platforms": ["macos", "windows", "linux"]}},
      {"name": "E030-连接失败日志", "props": {"chunk_id": "E030", "text": "verify_connectivity失败时可以启用驱动日志辅助判断地址、认证、版本兼容或服务状态问题。", "keywords": ["driver logs", "ServiceUnavailable", "连接失败"], "source_title": "Neo4j Python连接手册", "url": "https://neo4j.com/docs/python-manual/current/connect/", "section": "Diagnose connection failure", "platforms": ["macos", "windows", "linux"]}}
    ]
  },
