    "DiagnosticCheck": [
      {"name": "检查目标包", "props": {"description": "用运行程序的解释器查询包信息。", "command_macos": "python -m pip show <package>", "command_linux": "python -m pip show <package>", "command_windows": "py -m pip show <package>"}},
      {"name": "检查解释器路径", "props": {"description": "比较Python可执行文件和pip归属。", "command_macos": "python -c \"import sys; print(sys.executable)\" && python -m pip --version", "command_linux": "python -c \"import sys; print(sys.executable)\" && python -m pip --version", "command_windows": "py -c \"import sys; print(sys.executable)\" && py -m pip --version"}},
      {"name": "检查模块解析路径", "props": {"description": "查看Python最终会从哪里加载模块。", "command_macos": "python -c \"import importlib.util; print(importlib.util.find_spec('<module>'))\"", "command_linux": "python -c \"import importlib.util; print(importlib.util.find_spec('<module>'))\"", "command_windows": "py -c \"import importlib.util; print(importlib.util.find_spec('<module>'))\""}},
      {"name": "检查Python与依赖版本", "props": {"description": "记录Python版本并检查依赖冲突。", "command_macos": "python --version && python -m pip check", "command_linux": "python --version && python -m pip check", "command_windows": "py --version && py -m pip check"}},
      {"name": "检查GPU硬件", "props": {"description": "确认操作系统是否识别到目标GPU。", "command_macos": "system_profiler SPDisplaysDataType", "command_linux": "lspci | grep -i nvidia", "command_windows": "nvidia-smi"}},
      {"name": "检查NVIDIA驱动", "props": {"description": "用NVIDIA管理工具检查驱动和设备状态。", "command_macos": "system_profiler SPDisplaysDataType", "command_linux": "nvidia-smi", "command_windows": "nvidia-smi"}},
      {"name": "检查PyTorch构建", "props": {"description": "同时查看PyTorch版本、构建CUDA版本和运行时可用性。", "command_macos": "python -c \"import torch; print(torch.__version__, torch.version.cuda, torch.cuda.is_available())\"", "command_linux": "python -c \"import torch; print(torch.__version__, torch.version.cuda, torch.cuda.is_available())\"", "command_windows": "py -c \"import torch; print(torch.__version__, torch.version.cuda, torch.cuda.is_available())\""}},
      {"name": "检查容器GPU映射", "props": {"description": "确认容器启动配置是否请求GPU设备。", "command_macos": "docker inspect <container> --format '{{json .HostConfig.DeviceRequests}}'", "command_linux": "docker inspect <container> --format '{{json .HostConfig.DeviceRequests}}'", "command_windows": "docker inspect <container> --format '{{json .HostConfig.DeviceRequests}}'"}},
      {"name": "检查当前计算平台", "props": {"description": "识别操作系统，并检查MPS或CUDA后端。", "command_macos": "python -c \"import platform, torch; print(platform.platform(), torch.backends.mps.is_available())\"", "command_linux": "python -c \"import platform, torch; print(platform.platform(), torch.cuda.is_available())\"", "command_windows": "py -c \"import platform, torch; print(platform.platform(), torch.cuda.is_available())\""}},
      {"name": "检查环境变量", "props": {"description": "只检查变量是否存在，不输出密钥内容。", "command_macos": "python -c \"import os; print(bool(os.getenv('<KEY>')))\"", "command_linux": "python -c \"import os; print(bool(os.getenv('<KEY>')))\"", "command_windows": "py -c \"import os; print(bool(os.getenv('<KEY>')))\""}},
      {"name": "检查服务地址", "props": {"description": "核对配置中的协议、主机名和端口，不显示凭据。", "command_macos": "python -c \"from config.settings import settings; print(settings.neo4j_uri)\"", "command_linux": "python -c \"from config.settings import settings; print(settings.neo4j_uri)\"", "command_windows": "py -c \"from config.settings import settings; print(settings.neo4j_uri)\""}},
      {"name": "执行连接健康检查", "props": {"description": "显式执行连接验证，让连接错误在查询前暴露。", "command_macos": "python scripts/check_neo4j.py", "command_linux": "python scripts/check_neo4j.py", "command_windows": "py scripts/check_neo4j.py"}},
      {"name": "检查端口监听者", "props": {"description": "确认目标端口当前由哪个进程监听。", "command_macos": "lsof -nP -iTCP:<port> -sTCP:LISTEN", "command_linux": "ss -ltnp | grep ':<port>'", "command_windows": "netstat -ano | findstr :<port>"}},
      {"name": "检查认证错误", "props": {"description": "执行官方连接验证，并根据异常类型区分连接与认证问题。", "command_macos": "python scripts/check_neo4j.py", "command_linux": "python scripts/check_neo4j.py", "command_windows": "py scripts/check_neo4j.py"}}
    ],
