    "DiagnosticCheck": [
      {
        "name": "从Open WebUI容器检查Ollama端点",
        "props": {
          "description": "在Open WebUI容器内请求Ollama的/api/tags端点，验证容器到宿主机的实际路径。",
          "command_macos": "docker exec open-webui python -c \"import urllib.request; print(urllib.request.urlopen('http://host.docker.internal:11434/api/tags').status)\"",
          "command_linux": "docker exec open-webui python -c \"import urllib.request; print(urllib.request.urlopen('http://host.docker.internal:11434/api/tags').status)\"",
          "command_windows": "docker exec open-webui python -c \"import urllib.request; print(urllib.request.urlopen('http://host.docker.internal:11434/api/tags').status)\""
        }
      }
    ],
    "RepairAction": [
      {
        "name": "配置Open WebUI的Ollama宿主机地址",
        "props": {
          "instruction": "将Open WebUI的OLLAMA_BASE_URL设为http://host.docker.internal:11434，重启容器后再次请求/api/tags。Linux Docker Engine还需确认host-gateway映射。"
        }
      }
    ],
